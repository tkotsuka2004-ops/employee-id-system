# backend/.env.production.example
# Reference only — do NOT commit a real .env.production file with secrets.
# Set these as Environment Variables in the Vercel Project Settings
# (Production environment); Vercel injects them as real process env vars,
# which app/config.py (pydantic-settings) reads automatically.

# Vercel Functions are stateless/serverless: this must be a managed Postgres
# reachable over the network (e.g. Neon, Supabase, RDS) — Vercel cannot host
# Postgres itself, so postgresql://localhost from docker-compose will not work.
#
# For Supabase specifically: use the "Transaction pooler" (Supavisor)
# connection string from Dashboard -> Connect, on port 6543 — NOT the direct
# connection on port 5432, which won't scale across Vercel's serverless
# instances. Keep the postgresql+psycopg:// scheme (psycopg3) after swapping
# in the pooler host/port/password. app/database.py already disables
# SQLAlchemy's client-side pooling and prepared-statement caching for any
# non-sqlite URL, which is required for the transaction-mode pooler to work.
DATABASE_URL=postgresql+psycopg://<user>:<password>@<pooler-host>:6543/<database>

# Generate a strong random secret for production (e.g. `openssl rand -hex 32`).
AUTH_SECRET_KEY=<strong-random-secret>

# Comma-separated list of the real production frontend origin(s).
CORS_ORIGINS=https://<your-frontend>.vercel.app

# Vercel's filesystem is read-only outside /tmp, and /tmp is ephemeral and not
# shared across invocations/instances. The CSV bulk-import flow
# (app/routers/imports.py) writes a file on upload and reads it back on a
# later /execute request, which is NOT reliable across separate serverless
# invocations. Setting this to /tmp/imports avoids write failures, but
# imports can still fail if the follow-up request lands on a different
# instance. Treat bulk import as unsupported on this deployment until file
# storage is moved to something shared (e.g. S3-compatible/Vercel Blob).
IMPORT_STORAGE_DIR=/tmp/imports
